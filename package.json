{
  "name": "dota-browser-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5217 --strictPort",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1 --port 5217 --strictPort",
    "test": "node --import tsx --test tests/*.test.ts",
    "assets:prepare": "node scripts/prepare-classic.mjs",
    "assets:check": "node scripts/prepare-classic.mjs --check",
    "map:import": "node scripts/import-map.mjs",
    "map:check": "node scripts/check-map.mjs",
    "play:prepare": "node scripts/prepare-playable.mjs",
    "play:check": "node scripts/prepare-playable.mjs --check",
    "play:test": "node --import tsx scripts/playtest-battle.ts"
  },
  "dependencies": {
    "three": "0.180.0",
    "war3-model": "4.0.1"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "@types/three": "0.180.0",
    "mdx-m3-viewer": "5.12.0",
    "pngjs": "^7.0.0",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vite": "7.3.7"
  }
}
